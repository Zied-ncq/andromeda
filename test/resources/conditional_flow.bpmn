<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1bcd6cm" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:itemDefinition id="_ageItem" structureRef="number" />
  <bpmn:process id="conditional_flow" isExecutable="true">
    <bpmn:property id="age" itemSubjectRef="_ageItem" name="age" />
    <bpmn:startEvent id="start_1" name="start_1">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_excelusive" name="Excelusive Gateway">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_0" name="flow0" sourceRef="start_1" targetRef="Gateway_excelusive" />
    <bpmn:scriptTask id="script1" name="scrpipt1" scriptFormat="javascript">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_1e</bpmn:outgoing>
      <bpmn:script>console.log('age is greater than 25');</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="flow_1" name="flow1 (age&#62;=25)" sourceRef="Gateway_excelusive" targetRef="script1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">this.variables.age &gt; 25</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_2" name="flow2 (age&#60;25)" sourceRef="Gateway_excelusive" targetRef="script2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">this.variables.age &lt; 25</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="end2" name="end2">
      <bpmn:incoming>Flow_0rvssth</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0rvssth" name="flow_2e" sourceRef="script2" targetRef="end2" />
    <bpmn:endEvent id="end1" name="end1">
      <bpmn:incoming>flow_1e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1e" name="flow_1e" sourceRef="script1" targetRef="end1" />
    <bpmn:scriptTask id="script2" name="script2" scriptFormat="javascript">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_0rvssth</bpmn:outgoing>
      <bpmn:script>console.log('age is less than 25');</bpmn:script>
    </bpmn:scriptTask>
  </bpmn:process>
