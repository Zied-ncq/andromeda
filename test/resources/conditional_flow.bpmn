  <bpmn:itemDefinition id="_ageItem" structureRef="number" />
  <bpmn:process id="conditional_flow" isExecutable="true">
    <bpmn:property id="age" itemSubjectRef="_ageItem" name="age" />
    <bpmn:startEvent id="start_1" name="start_1">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end1" name="end1">
      <bpmn:incoming>flow_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="script1" name="script1" scriptFormat="javascript">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
      <bpmn:script>console.log('---- script 1 ----');</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="flow_1" name="flow_1" sourceRef="script1" targetRef="end1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">this.variables.age &gt; 11</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_0" name="flow0" sourceRef="start_1" targetRef="script1">
      <bpmn:extensionElements />
    </bpmn:sequenceFlow>
  </bpmn:process>
